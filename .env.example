# TaskFlow-SaaS — Environment Variables
# Copy this file to .env and update with your actual values.
#
# Quick start (frontend + infra only, no Java build):
#   docker compose -f docker-compose.dev.yml up -d
#
# Full stack (4 Java microservices + gateway + Kafka, ~10-15 min first build):
#   docker compose up -d

# ── Database (PostgreSQL) ───────────────────────────────────────
POSTGRES_DB=anchorboard_platform
POSTGRES_USER=anchorboard_user
POSTGRES_PASSWORD=anchorboard_password
DATABASE_URL=jdbc:postgresql://postgres:5432/anchorboard_platform

# ── Redis (cache / session store) ───────────────────────────────
SPRING_REDIS_HOST=redis
SPRING_REDIS_PORT=6379

# ── Kafka (event streaming for notifications) ───────────────────
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
# Host-exposed listener for local tools (e.g. kafka-console-consumer)
KAFKA_HOST_PORT=29092

# ── JWT / Auth ───────────────────────────────────────────────────
JWT_SECRET=your-super-secure-jwt-secret-key-minimum-256-bits
JWT_EXPIRATION=86400000

# ── Spring profile ───────────────────────────────────────────────
# Use "docker" for the local docker-compose stack, "prod" for production
SPRING_PROFILES_ACTIVE=docker

# ── Frontend (Next.js) ───────────────────────────────────────────
# URL the frontend uses to reach the Spring Cloud Gateway.
# Frontend -> backend URLs. Baked in at `npm run build` time (Next.js
# inlines NEXT_PUBLIC_* vars into the client bundle). The gateway service has
# no configured routes, so the browser calls each Spring Boot service
# directly on its own port instead of through a single origin.
NEXT_PUBLIC_AUTH_API_URL=http://localhost:8081/api
NEXT_PUBLIC_PROJECT_API_URL=http://localhost:8082/api
NEXT_PUBLIC_NOTIFICATION_API_URL=http://localhost:8083/api
NEXT_PUBLIC_DEFAULT_TENANT_ID=1
NEXT_TELEMETRY_DISABLED=1

# ── Service ports (for reference — already set in docker-compose) ─
# auth-service:          8081
# project-service:       8082
# notification-service:  8083
# gateway (unused, no routes): 8090
# frontend:               3000
# postgres:               5432
# redis:                  6379
# kafka (host listener):  29092

# ── Monitoring and Logging ───────────────────────────────────────
LOG_LEVEL=INFO
# METRICS_ENABLED=true

# ── External Service URLs (optional, not required for local dev) ─
# EMAIL_SERVICE_URL=https://your-email-service.com
# NOTIFICATION_SERVICE_URL=https://your-notification-service.com
